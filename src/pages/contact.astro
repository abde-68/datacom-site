---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
const endpoint = 'https://formsubmit.co/a.kadaoui@datacom-ingenierie.com';
---
<BaseLayout title="Contact et demande de devis" description="Parlons de votre projet d’électricité, de fibre optique ou de plomberie. DATACOM vous accompagne avec une étude et un devis gratuits.">
  <section class="page-intro"><div class="container-page"><p class="eyebrow">Le début de votre projet</p><h1 class="h-title">Parlons de vos besoins.</h1><p>Une question, des travaux ou un dépannage ? Construisons ensemble une solution adaptée.</p></div></section>
  <section class="section"><div class="container-page contact-grid">
    <div class="contact-info" id="coordonnees"><p class="eyebrow">Un interlocuteur unique</p><h2 class="h-title">À votre écoute,<br />à chaque étape.</h2><p>Expliquez-nous votre besoin, le lieu d’intervention et vos contraintes. Nous étudierons votre demande pour vous proposer un devis clair, gratuit et sans engagement.</p>
      <ul>
        <li><strong>Téléphone :</strong> <a href="tel:+33767067967">07 67 06 79 67</a></li>
        <li><strong>E-mail :</strong> <a href="mailto:a.kadaoui@datacom-ingenierie.com">a.kadaoui@datacom-ingenierie.com</a></li>
        {site.adresse && <li><strong>Adresse :</strong> {site.adresse}</li>}
        {site.horaires && <li><strong>Horaires :</strong> {site.horaires}</li>}
      </ul>
      {!site.telephoneLien && <p class="contact-note">Vous pouvez nous contacter par e-mail pour votre demande de devis.</p>}
      <p>Électricité, fibre optique, plomberie : des compétences complémentaires pour simplifier vos travaux.</p>
    </div>
    <form id="devis-form" class="contact-form" method="post" action={endpoint} enctype="multipart/form-data">
      <h2 class="text-xl font-semibold mb-3">Demander un devis</h2>
      <p class="form-help">Tous les champs marqués d’un astérisque (*) sont obligatoires.</p>
      <input type="hidden" name="_subject" value="Nouvelle demande de devis — DATACOM" />
      <input type="hidden" name="_template" value="table" />
      <div class="form-grid">
        <label>Nom *<input required name="nom" type="text" autocomplete="family-name" /></label>
        <label>Prénom *<input required name="prenom" type="text" autocomplete="given-name" /></label>
        <label>E-mail *<input required name="email" type="email" autocomplete="email" /></label>
        <label>Téléphone *<input required name="telephone" type="tel" autocomplete="tel" /></label>
        <label>Commune<input name="commune" type="text" autocomplete="address-level2" /></label>
        <label>Type de service *<select required name="service"><option value="">Choisir un service</option><option value="electricite">Électricité</option><option value="fibre">Fibre optique</option><option value="plomberie">Plomberie</option></select></label>
      </div>
      <label>Niveau d’urgence<select name="urgence"><option value="normal">Projet à planifier</option><option value="rapide">Intervention souhaitée rapidement</option><option value="urgent">Demande urgente</option></select></label>
      <label>Votre besoin *<textarea required name="message" rows="5"></textarea></label>
      <fieldset class="mb-5">
        <legend class="text-sm font-semibold mb-3">Photos (facultatif)</legend>
        <p class="form-help">Jusqu’à 3 photos JPG, PNG ou WebP, 10 Mo maximum au total. Évitez les documents sensibles.</p>
        {[1, 2, 3].map(i => (
          <label>Photo {i}
            <input name={`attachment${i}`} type="file" accept="image/jpeg,image/png,image/webp" />
          </label>
        ))}
      </fieldset>
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />
      <label class="consent"><input required type="checkbox" name="rgpd" /><span>J’accepte que mes données soient utilisées pour traiter ma demande, conformément à la <a href={withBase('/politique-de-confidentialite')}>politique de confidentialité</a>. *</span></label>
      <button type="submit" class="btn-primary w-full disabled:opacity-50 disabled:cursor-not-allowed">Envoyer ma demande</button>
      <p id="form-message" class="form-message" role="status" aria-live="polite" hidden></p>
      <noscript><p class="form-help mt-4">Le formulaire peut être envoyé sans JavaScript. Respectez la limite de 10 Mo pour l’ensemble des photos.</p></noscript>
    </form>
  </div></section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#devis-form');
    const message = document.querySelector<HTMLElement>('#form-message');
    const photos = form?.querySelectorAll<HTMLInputElement>('input[type="file"]');
    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

    function validatePhotos(): boolean {
      const files = [...(photos || [])].flatMap(input => [...(input.files || [])]);
      let error = '';
      if (files.some(file => !allowedTypes.includes(file.type))) {
        error = 'Veuillez sélectionner uniquement des photos JPG, PNG ou WebP.';
      } else if (files.reduce((total, file) => total + file.size, 0) > 10000000) {
        error = 'Les photos dépassent 10 Mo au total. Réduisez leur taille ou retirez-en une.';
      }
      if (message) {
        message.textContent = error;
        message.hidden = !error;
      }
      return !error;
    }

    photos?.forEach(input => input.addEventListener('change', validatePhotos));
    form?.addEventListener('submit', event => {
      // Envoi HTML natif pour les pièces jointes et le CAPTCHA FormSubmit.
      // Ne pas rétablir l’ancien fetch AJAX.
      if (!validatePhotos()) {
        event.preventDefault();
        message?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  </script>
</BaseLayout>

