# ============================================================
# Variables d'environnement DATACOM - NE JAMAIS committer .env
# Copiez ce fichier en .env et remplissez les valeurs reelles.
# ============================================================

# Destinataire des demandes de devis (email de l'entreprise)
CONTACT_EMAIL=

# Service d'envoi d'email (ex: Resend). Cle PRIVEE cote serveur uniquement.
RESEND_API_KEY=

# Protection antispam (ex: Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL PUBLIQUE HTTPS du service qui reçoit les demandes (jamais une clé secrète).
# Vide : formulaire explicitement désactivé, aucune demande faussement confirmée.
PUBLIC_DEVIS_ENDPOINT=

# true uniquement si le service choisi autorise les photos (forfait adapté).
PUBLIC_DEVIS_PHOTOS_ENABLED=false
